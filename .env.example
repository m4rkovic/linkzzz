# Prisma/PostgreSQL is the only application runtime persistence adapter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkzzz?schema=public
# Hosted PostgreSQL (including Neon) must verify the certificate and hostname:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Local development uses the in-memory adapter when this is omitted.
# Production must use the shared Upstash adapter.
RATE_LIMIT_BACKEND=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional, accepted range 250-10000 milliseconds. Default: 2000.
RATE_LIMIT_REDIS_TIMEOUT_MS=2000

# Local development stores uploads under public/uploads when this is omitted.
# Production must use an S3-compatible object store.
ASSET_STORAGE_ADAPTER=
# Optional per-customer asset quota in bytes. Default: 512 MiB.
ASSET_STORAGE_QUOTA_BYTES=536870912
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Comma-separated production hostnames, without protocol or path.
LINKZZZ_APP_HOSTS=linkzzz.com,www.linkzzz.com
# Public hostname that customer custom domains should CNAME to.
LINKZZZ_CUSTOM_DOMAIN_TARGET=domains.linkzzz.com
# Trust x-forwarded-* / edge geo headers only when the app is behind your trusted proxy/CDN.
# Production must set this explicitly to 0 or 1.
LINKZZZ_TRUST_PROXY_HEADERS=0
# Exactly one country header supplied and sanitized by your trusted edge.
# Vercel: x-vercel-ip-country | Cloudflare: cf-ipcountry
LINKZZZ_GEO_HEADER=x-vercel-ip-country

# Public landing-page access requests open the visitor's email client.
NEXT_PUBLIC_LINKZZZ_CONTACT_EMAIL=hello@linkzzz.com

# Optional local seed overrides. Never reuse these development values in production.
DEV_ADMIN_PASSWORD=
DEV_SKYHOOK_PASSWORD=

# Optional. Core-route development prewarm is OFF by default because compiling
# the protected route set during every startup can make normal dev navigation
# feel slower. Set to 1 only when you explicitly want to precompile it.
LINKZZZ_DEV_PREWARM=0

# Optional E2E overrides. Defaults target the local seeded admin.
E2E_BASE_URL=http://127.0.0.1:3100
# Required for Playwright. This must be a disposable PostgreSQL database and
# must not be the same database as DATABASE_URL.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkzzz_e2e?schema=public
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=
# Set to 1 only when E2E_BASE_URL already points to a separately managed server.
E2E_EXTERNAL_SERVER=0

# Optional trusted-edge bot verification. Only an edge layer you control should
# send the matching secret together with x-linkzzz-verified-crawler: true.
LINKZZZ_EDGE_BOT_SECRET=

# Used only to create rotating, pseudonymous internal analytics visitor IDs.
# Use a long random value in production. Local development may omit it.
LINKZZZ_ANALYTICS_HASH_SALT=
