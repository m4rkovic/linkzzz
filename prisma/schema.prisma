generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCEL_AT_PERIOD_END
  EXPIRED
  STOPPED
}

enum SmartLinkStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum SmartLinkType {
  LANDING_PAGE
  DIRECT
}

enum AnalyticsEventType {
  PAGE_VIEW
  LINK_CLICK
  SOCIAL_CLICK
  SMART_LINK_VIEW
  DEEPLINK_ATTEMPT
  DEEPLINK_FALLBACK
  BLOCKED_AUTOMATED_REQUEST
}

enum AssetType {
  AVATAR
  COVER
  LINK_IMAGE
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  DISABLED
}

model User {
  id            String        @id @default(uuid())
  username      String        @unique
  email         String        @unique
  displayName   String?
  role          UserRole      @default(CUSTOMER)
  accountStatus AccountStatus @default(ACTIVE)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  smartLinks   SmartLink[]
  credential   PasswordCredential?
  subscription Subscription?
  sessions     Session[]

  subscriptionHistory SubscriptionHistory[]
  auditEventsAsActor  AuditLog[]            @relation("AuditActor")
  auditEventsAsTarget AuditLog[]            @relation("AuditTarget")
}

model SmartLink {
  id     String @id @default(uuid())
  userId String

  type   SmartLinkType   @default(LANDING_PAGE)
  title  String
  slug   String          @unique
  status SmartLinkStatus @default(DRAFT)

  primaryDestination Json?
  deeplinkConfig     Json  @default("{\"enabled\":true,\"strategy\":\"SMART\",\"openInBrowserHelper\":false,\"longPressHelper\":false}")
  geoConfig          Json  @default("{\"enabled\":false,\"rules\":[],\"fallback\":{\"type\":\"DEFAULT_PAGE\"}}")
  shieldConfig       Json  @default("{\"enabled\":false,\"mode\":\"STANDARD\",\"verifiedCrawlerPolicy\":\"ALLOW\"}")
  trackingConfig     Json  @default("{\"internalAnalytics\":true}")

  revision Int @default(1)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  page            Page?
  assets          Asset[]
  analyticsEvents AnalyticsEvent[]
  leadSubmissions LeadSubmission[]
  domains         CustomDomain[]

  @@index([userId])
  @@index([type])
  @@index([status])
}

model PasswordCredential {
  id                 String  @id @default(uuid())
  userId             String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(true)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id     String             @id @default(uuid())
  userId String             @unique
  plan   PlanType
  status SubscriptionStatus @default(ACTIVE)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  autoRenew Boolean @default(false)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionHistory {
  id       String             @id @default(uuid())
  userId   String
  plan     PlanType
  status   SubscriptionStatus
  startsAt DateTime?          @db.Timestamptz(3)
  endsAt   DateTime?          @db.Timestamptz(3)
  action   String
  metadata Json?

  createdAt DateTime @db.Timestamptz(3) @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Page {
  id          String @id @default(uuid())
  smartLinkId String @unique

  displayName   String
  username      String?
  bio           String  @default("")
  locationLabel String?

  avatarAssetId String?
  coverAssetId  String?

  avatarAsset Asset? @relation("PageAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  coverAsset  Asset? @relation("PageCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  appearance    Json
  contentBlocks Json @default("[]")
  revision      Int  @default(1)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  smartLink SmartLink @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)

  cards   PageCard[]
  socials SocialLink[]
  stats   PageStat[]

  @@index([avatarAssetId])
  @@index([coverAssetId])
}

model PageCard {
  id     String @id @default(uuid())
  pageId String

  title       String
  description String?
  url         String
  visible     Boolean @default(true)
  sortOrder   Int     @default(0)

  platform      String?
  layout        String?
  aspectRatio   String?
  imageFit      String?
  imagePosition String?
  titlePosition String?

  showPlatformIcon Boolean @default(true)
  showTitle        Boolean @default(true)
  showDescription  Boolean @default(true)

  overlayEnabled Boolean @default(false)
  overlayOpacity Float?

  customStyle Json?

  imageAssetId String?
  imageAsset   Asset?  @relation("PageCardImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  page            Page                     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  geoDestinations PageCardGeoDestination[]
  analyticsEvents AnalyticsEvent[]

  @@index([pageId, sortOrder])
  @@index([imageAssetId])
}

model PageCardGeoDestination {
  id          String @id @default(uuid())
  pageCardId  String
  countryCode String
  countryName String
  url         String

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  pageCard PageCard @relation(fields: [pageCardId], references: [id], onDelete: Cascade)

  @@index([pageCardId])
  @@index([countryCode])
}

model SocialLink {
  id     String @id @default(uuid())
  pageId String

  name      String
  url       String
  visible   Boolean @default(true)
  platform  String?
  sortOrder Int     @default(0)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model PageStat {
  id     String @id @default(uuid())
  pageId String

  value     String
  label     String
  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Asset {
  id          String @id @default(uuid())
  smartLinkId String

  type AssetType

  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int

  width  Int?
  height Int?

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  smartLink SmartLink  @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)
  avatarFor Page[]     @relation("PageAvatar")
  coverFor  Page[]     @relation("PageCover")
  imageFor  PageCard[] @relation("PageCardImage")

  @@index([smartLinkId])
}

model AnalyticsEvent {
  id          String  @id @default(uuid())
  smartLinkId String
  pageCardId  String?

  type AnalyticsEventType

  visitorId String?
  referrer  String?

  countryCode String?
  countryName String?
  city        String?

  device  String?
  browser String?
  os      String?

  isBot Boolean @default(false)

  createdAt DateTime @db.Timestamptz(3) @default(now())

  smartLink SmartLink @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)
  pageCard  PageCard? @relation(fields: [pageCardId], references: [id], onDelete: SetNull)

  @@index([smartLinkId, createdAt])
  @@index([smartLinkId, isBot, type, createdAt])
  @@index([pageCardId, type, createdAt])
  @@index([createdAt])
  @@index([type])
}

model LeadSubmission {
  id          String @id @default(uuid())
  smartLinkId String
  blockId     String
  email       String

  createdAt DateTime @db.Timestamptz(3) @default(now())

  smartLink SmartLink @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)

  @@index([smartLinkId])
  @@index([blockId])
  @@index([createdAt])
}

model CustomDomain {
  id          String @id @default(uuid())
  smartLinkId String

  domain            String             @unique
  status            CustomDomainStatus @default(PENDING)
  verificationToken String             @unique
  verifiedAt        DateTime?           @db.Timestamptz(3)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  updatedAt DateTime @db.Timestamptz(3) @updatedAt

  smartLink SmartLink @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)

  @@index([smartLinkId])
}

model AuditLog {
  id String @id @default(uuid())

  actorUserId  String?
  targetUserId String?

  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?

  ipAddress String?

  createdAt DateTime @db.Timestamptz(3) @default(now())

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@index([action])
}
