generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlanType {
  PREMIUM
  PREMIUM_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  CANCEL_AT_PERIOD_END
  EXPIRED
  STOPPED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum AnalyticsEventType {
  PAGE_VIEW
  LINK_CLICK
  SOCIAL_CLICK
}

enum AssetType {
  AVATAR
  COVER
  LINK_IMAGE
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  DISABLED
}

model User {
  id            String        @id @default(uuid())
  username      String        @unique
  email         String        @unique
  displayName   String?
  role          UserRole      @default(CUSTOMER)
  accountStatus AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile?
  credential   PasswordCredential?
  subscription Subscription?
  sessions     Session[]

  subscriptionHistory SubscriptionHistory[]
  auditEventsAsActor  AuditLog[]            @relation("AuditActor")
  auditEventsAsTarget AuditLog[]            @relation("AuditTarget")
}

model PasswordCredential {
  id                 String  @id @default(uuid())
  userId             String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id     String             @id @default(uuid())
  userId String             @unique
  plan   PlanType
  status SubscriptionStatus @default(ACTIVE)

  startsAt DateTime
  endsAt   DateTime

  autoRenew Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionHistory {
  id       String             @id @default(uuid())
  userId   String
  plan     PlanType
  status   SubscriptionStatus
  startsAt DateTime?
  endsAt   DateTime?
  action   String
  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Profile {
  id     String        @id @default(uuid())
  userId String        @unique
  slug   String        @unique
  status ProfileStatus @default(DRAFT)

  displayName   String
  username      String?
  bio           String  @default("")
  locationLabel String?

  avatarAssetId String?
  coverAssetId  String?

  avatarAsset Asset? @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  coverAsset  Asset? @relation("ProfileCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  appearance Json
  revision   Int  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  links           Link[]
  socials         SocialLink[]
  stats           ProfileStat[]
  assets          Asset[]          @relation("OwnedAssets")
  domains         CustomDomain[]
  analyticsEvents AnalyticsEvent[]

  @@index([avatarAssetId])
  @@index([coverAssetId])
}

model Link {
  id        String @id @default(uuid())
  profileId String

  title       String
  description String?
  url         String
  visible     Boolean @default(true)
  sortOrder   Int     @default(0)

  platform      String?
  layout        String?
  aspectRatio   String?
  imageFit      String?
  imagePosition String?
  titlePosition String?

  showPlatformIcon Boolean @default(true)
  showTitle        Boolean @default(true)
  showDescription  Boolean @default(true)

  overlayEnabled Boolean @default(false)
  overlayOpacity Int?

  customStyle Json?

  imageAssetId String?
  imageAsset   Asset?  @relation("LinkImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  geoDestinations GeoDestination[]
  analyticsEvents AnalyticsEvent[]

  @@index([profileId])
  @@index([sortOrder])
  @@index([imageAssetId])
}

model GeoDestination {
  id          String @id @default(uuid())
  linkId      String
  countryCode String
  countryName String
  url         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([countryCode])
}

model SocialLink {
  id        String @id @default(uuid())
  profileId String

  name      String
  url       String
  visible   Boolean @default(true)
  platform  String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ProfileStat {
  id        String @id @default(uuid())
  profileId String

  value     String
  label     String
  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Asset {
  id        String @id @default(uuid())
  profileId String

  type AssetType

  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int

  width  Int?
  height Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   Profile   @relation("OwnedAssets", fields: [profileId], references: [id], onDelete: Cascade)
  avatarFor Profile[] @relation("ProfileAvatar")
  coverFor  Profile[] @relation("ProfileCover")
  imageFor  Link[]    @relation("LinkImage")

  @@index([profileId])
}

model AnalyticsEvent {
  id        String  @id @default(uuid())
  profileId String
  linkId    String?

  type AnalyticsEventType

  visitorId String?
  referrer  String?

  countryCode String?
  countryName String?
  city        String?

  device  String?
  browser String?
  os      String?

  isBot Boolean @default(false)

  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  link    Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([linkId])
  @@index([createdAt])
  @@index([type])
}

model CustomDomain {
  id        String @id @default(uuid())
  profileId String

  domain            String             @unique
  status            CustomDomainStatus @default(PENDING)
  verificationToken String             @unique
  verifiedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AuditLog {
  id String @id @default(uuid())

  actorUserId  String?
  targetUserId String?

  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?

  ipAddress String?

  createdAt DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@index([action])
}
