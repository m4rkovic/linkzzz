{
  "name": "linkzzz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:turbo": "node scripts/dev-server.mjs",
    "dev:raw": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:e2e": "node --import tsx scripts/start-e2e-server.ts",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run test:e2e:functional",
    "test:e2e:all": "npm run test:e2e:functional && npm run test:e2e:visual",
    "test:e2e:functional": "playwright test e2e/critical-flow.spec.ts e2e/keyboard-accessibility.spec.ts e2e/smart-link-quota-concurrency.spec.ts e2e/admin-subscription-concurrency.spec.ts e2e/admin-account-concurrency.spec.ts e2e/database-timezone.spec.ts e2e/admin-subscription-date-contract.spec.ts e2e/admin-smartlink-transaction.spec.ts e2e/landing-page-delete-concurrency.spec.ts e2e/smart-link-create-rate-limit.spec.ts e2e/public-runtime-parity.spec.ts e2e/page-child-integrity.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium webkit",
    "clean:test-artifacts": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item ./test-results,./playwright-report -Recurse -Force -ErrorAction SilentlyContinue\"",
    "clean:next": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item ./.next -Recurse -Force -ErrorAction SilentlyContinue\"",
    "zip:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-release-zip.ps1",
    "env:check": "tsx scripts/check-production-env.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "test:e2e:critical": "playwright test e2e/critical-flow.spec.ts --project=desktop-1440 --workers=1",
    "test:e2e:keyboard": "playwright test e2e/keyboard-accessibility.spec.ts --workers=4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
